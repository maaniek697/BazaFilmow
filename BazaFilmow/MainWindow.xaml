<Window x:Class="BazaFilmow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baza Filmów" Height="500" Width="1100"
        Background="#1E1E1E">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
            <TextBox x:Name="TytulTextBox" Width="300" Height="35" FontSize="16" Padding="5" 
                     Background="#333333" Foreground="White" BorderBrush="#555555"
                     VerticalContentAlignment="Center" KeyDown="TytulTextBox_KeyDown"/>
            <Button x:Name="SzukajButton" Content="Szukaj Filmu" Width="120" Height="35" Margin="10,0,0,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Click="SzukajButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/> <ColumnDefinition Width="*"/>   <ColumnDefinition Width="300"/> </Grid.ColumnDefinitions>

            <Image x:Name="PlakatImage" Grid.Column="0" Stretch="Uniform" Margin="0,0,20,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,20,0">
                <TextBlock x:Name="TytulTextBlock" Text="Wyszukaj film..." FontSize="32" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="RokTextBlock" Text="Rok: -" FontSize="16" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                <TextBlock x:Name="OcenaTextBlock" Text="Ocena IMDb: -" FontSize="16" Foreground="#FFD700" Margin="0,5,0,20" FontWeight="Bold"/>
                <TextBlock x:Name="OpisTextBlock" Text="Tutaj pojawi się opis fabuły." 
                           FontSize="16" Foreground="#DDDDDD" TextWrapping="Wrap" LineHeight="22"/>
                
                <Button x:Name="ZapiszButton" Content="Dodaj do obejrzanych" Width="160" Height="35" Margin="0,20,0,0" 
                        HorizontalAlignment="Left" Background="#28A745" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Click="ZapiszButton_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="KomunikatTextBlock" Text="" Foreground="#28A745" Margin="0,5,0,0" FontSize="14" FontWeight="Bold"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Moja Kolekcja:" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                
                <ListBox x:Name="ListaFilmowBox" Grid.Row="1" Background="#252526" Foreground="#DDDDDD" 
                         BorderBrush="#555555" FontSize="14" Padding="5"/>
            </Grid>
        </Grid>
    </Grid>
</Window>